# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# Neon Postgres (PostGIS enabled), Singapore region (aws-ap-southeast-1). Use the DIRECT
# connection string, not the pooled one (no "-pooler" in the host): migrations are long
# transactions and pooled connections break them.
DATABASE_URL=postgresql://user:password@host.neon.tech/optev?sslmode=require

# Neo4j Aura Free. From the credentials file Aura downloads at instance creation.
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# LTA DataMall. Register at https://datamall.lta.gov.sg/content/datamall/en/request-for-api.html
LTA_ACCOUNT_KEY=

# Language model for the explanation layer (optev/graph/llm.py). It only rewords evidence.
# LLM_PROVIDER: deepseek | gemini | anthropic | openai_compatible (then also LLM_BASE_URL)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
